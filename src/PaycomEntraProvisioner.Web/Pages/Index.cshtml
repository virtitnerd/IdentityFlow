@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Dashboard</h1>
    <form method="post" asp-page-handler="RunNow" class="d-flex align-items-center gap-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="true" name="dryRun" id="dryRun" />
            <label class="form-check-label" for="dryRun">Dry run (preview only, no writes)</label>
        </div>
        <button type="submit" class="btn btn-primary">Run Sync Now</button>
    </form>
</div>

<p class="text-muted">
    Runs the full Paycom &rarr; Entra ID pipeline immediately: pulls current worker data from Paycom,
    submits mapped SCIM records to the Entra ID API-driven inbound provisioning job, and reconciles
    assigned-group membership. The scheduled Azure Function runs the same pipeline automatically.
</p>

<h2 class="h4 mt-4">Recent sync runs</h2>

@if (Model.RecentRuns.Count == 0)
{
    <p class="text-muted">No sync runs recorded yet.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Started</th>
                <th>Trigger</th>
                <th>Status</th>
                <th class="text-end">Evaluated</th>
                <th class="text-end">Submitted</th>
                <th class="text-end">Skipped</th>
                <th class="text-end">Failed</th>
                <th class="text-end">Group +/-</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in Model.RecentRuns)
            {
                <tr>
                    <td>@run.StartedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        @run.Trigger
                        @if (run.DryRun)
                        {
                            <span class="badge text-bg-secondary">dry run</span>
                        }
                    </td>
                    <td>
                        <span class="badge @(run.Status switch {
                            Core.Domain.SyncRunStatus.Succeeded => "text-bg-success",
                            Core.Domain.SyncRunStatus.CompletedWithErrors => "text-bg-warning",
                            Core.Domain.SyncRunStatus.Failed => "text-bg-danger",
                            _ => "text-bg-secondary"
                        })">@run.Status</span>
                    </td>
                    <td class="text-end">@run.EmployeesEvaluated</td>
                    <td class="text-end">@run.RecordsSubmitted</td>
                    <td class="text-end">@run.RecordsSkipped</td>
                    <td class="text-end">@run.RecordsFailed</td>
                    <td class="text-end">+@run.GroupMembershipsAdded / -@run.GroupMembershipsRemoved</td>
                    <td><a asp-page="/SyncRuns/Details" asp-route-id="@run.Id">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-page="/SyncRuns/Index">View full history &rarr;</a>
}
