@page
@model IdentityFlow.Web.Pages.SyncRuns.IndexModel
@{
    ViewData["Title"] = "Sync History";
}

<h1>Sync History</h1>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Started</th>
            <th>Completed</th>
            <th>Trigger</th>
            <th>Status</th>
            <th class="text-end">Evaluated</th>
            <th class="text-end">Submitted</th>
            <th class="text-end">Skipped</th>
            <th class="text-end">Failed</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var run in Model.Runs)
        {
            <tr>
                <td>@run.StartedAt.ToLocalTime().ToString("g")</td>
                <td>@(run.CompletedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                <td>@run.Trigger @(run.DryRun ? "(dry run)" : "")</td>
                <td>@run.Status</td>
                <td class="text-end">@run.EmployeesEvaluated</td>
                <td class="text-end">@run.RecordsSubmitted</td>
                <td class="text-end">@run.RecordsSkipped</td>
                <td class="text-end">@run.RecordsFailed</td>
                <td><a asp-page="/SyncRuns/Details" asp-route-id="@run.Id">Details</a></td>
            </tr>
        }
    </tbody>
</table>
